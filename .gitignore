credentials.json
token.json
.env

# Never commit OAuth client secrets or backups under any name/extension
**/client_secret*.json
*.old-deleted-oauth
__pycache__/
*.pyc

# Thumbnail images
thumbnails/
*.jpg
*.jpeg
*.png

# Scratch files from browser-pilot / ad-hoc tests
tmp_*.json
tmp_*.png

# Playwright session cookies — full TikTok account auth, never commit
.tiktok-session.json
analytics/_debug-*.html
analytics/_debug-*.png

# Gmail PDFs — personal correspondence, repo is public on GitHub
Gmail*.pdf
docs/Gmail*.pdf

# Rendered clone videos — too big for git, stored locally only
clonevideos/

# Video files — too big for git, sandbox demos / source clips stored locally
*.mp4
*.mov
*.webm
*.mkv

# Claude Code local state — ignore everything in .claude/ EXCEPT the
# memory subfolder (which is synced cross-machine via `npm run memory:push`).
.claude/*
!.claude/memory/
!.claude/memory/**

# Node modules (in case npm install ever runs for the memory-sync script)
node_modules/

# Remotion project — source committed, but skip rendered output, copied
# public assets, and dep tree. Originals live under faith-walk-live/anchor-doc/.
src/anchor-doc/out/
src/anchor-doc/public/audio/
src/anchor-doc/public/cards/
src/anchor-doc/public/clips/
src/anchor-doc/public/zay-monologue/
src/anchor-doc/package-lock.json
src/shorts/out/
src/shorts/public/clips/
src/shorts/package-lock.json

# Custom Script 2.0 — training data + generated artifacts. Scripts are
# committed; the trained LoRA URL, ~150-image dataset, and scraper debug
# dumps stay local only. Reference images are scraped from the user's
# fal.ai history and bound to their account.
training/lora-references/
training/lora-dataset.zip
training/lora-config.json
training/fal-*.json
training/fal-*.html
training/fal-*.png

# Generated scene JSON (regenerable from drafts/*.txt via scripts/script-to-scenes.py)
output/scenes/
# Debug compare downloads
output/compare/
# Ad-hoc analytics scratch files (TikTok pilot logs, comment dumps)
analytics/_tt-*
analytics/_tiktok-*
output/tt-comments-*.md
